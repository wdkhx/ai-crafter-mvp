.toolbox-hero {
  min-height: 300rpx;
  display: flex;
  align-items: flex-end;
  padding: 40rpx 8rpx 28rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
  margin-bottom: 14rpx;
}

.toolbox-title {
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #172026;
  max-width: 600rpx;
}

.toolbox-subtitle {
  margin-top: 18rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.55;
}

.quick-start {
  padding: 32rpx;
  border: 2rpx solid #ccfbef;
}

.card-topline,
.tool-footer,
.default-row,
.action-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #0f766e;
  color: #ffffff;
  display: grid;
  place-items: center;
  font-size: 30rpx;
  font-weight: 800;
}

.tool-icon.large {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
}

.badge {
  background: #ecfdf5;
  color: #047857;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tool-title,
.paper-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #172026;
}

.paper-title {
  margin-top: 0;
}

.tool-desc,
.paper-subtitle,
.coming-desc,
.default-desc,
.safe-note,
.quiet-line {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
}

.tool-desc {
  margin-top: 14rpx;
}

.tool-footer {
  margin-top: 30rpx;
  color: #475467;
  font-size: 25rpx;
}

.arrow {
  color: #0f766e;
  font-weight: 800;
}

.section-label {
  margin: 34rpx 0 18rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 700;
}

.coming-grid {
  display: grid;
  gap: 16rpx;
}

.coming-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 24rpx;
  opacity: 0.82;
}

.coming-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
  display: grid;
  place-items: center;
  color: #475467;
  font-weight: 800;
}

.coming-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #344054;
}

.nav-row {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
  margin: 10rpx 0 18rpx;
}

.paper-intro {
  display: flex;
  gap: 22rpx;
  align-items: center;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  color: #344054;
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  min-height: 88rpx;
  background: #f9fafb;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.main-input {
  min-height: 190rpx;
  font-size: 30rpx;
}

.textarea.short {
  height: 120rpx;
}

.mini-btn {
  width: 118rpx;
  margin: 0;
  background: #f0fdfa;
  color: #0f766e;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 2.4;
}

.default-title {
  color: #344054;
  font-size: 26rpx;
  font-weight: 800;
}

.advanced {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #eaecf0;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.safe-note {
  text-align: center;
  margin-top: 18rpx;
  font-size: 23rpx;
}

.status-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.progress-row,
.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: space-between;
  color: #667085;
  font-size: 24rpx;
  margin: 18rpx 0 24rpx;
}

.steps {
  margin: 28rpx 0;
}

.step {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d0d5dd;
}

.dot.succeeded {
  background: #12b76a;
}

.dot.running {
  background: #0f766e;
}

.step-name {
  font-size: 28rpx;
  font-weight: 700;
}

.step-summary {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.result-kicker {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.result-title {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.action-grid {
  margin-top: 20rpx;
}

.action-grid button {
  flex: 1;
}

.plain-btn {
  background: transparent;
  color: #667085;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.section-title {
  margin: 28rpx 0 12rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.paper-text,
.reference {
  color: #344054;
  font-size: 28rpx;
  line-height: 1.85;
  word-break: break-word;
}
