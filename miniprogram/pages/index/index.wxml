<view class="page page--safe">
  <toolbox-home
    wx:if="{{viewState === 'toolbox'}}"
    available-tools="{{availableTools}}"
    upcoming-tools="{{upcomingTools}}"
    bindselecttool="handleSelectTool"
  ></toolbox-home>

  <review-form
    wx:if="{{viewState === 'form'}}"
    form="{{form}}"
    depth-options="{{depthOptions}}"
    depth-display-options="{{depthDisplayOptions}}"
    current-depth-label="{{currentDepthLabel}}"
    depth-index="{{depthIndex}}"
    show-advanced="{{showAdvanced}}"
    submitting="{{submitting}}"
    bindformchange="handleFormChange"
    binddepthchange="handleDepthChange"
    bindtoggleadvanced="handleToggleAdvanced"
    bindsubmit="submitReview"
    bindback="backToToolbox"
  ></review-form>

  <task-progress
    wx:if="{{viewState === 'running'}}"
    task="{{task}}"
    bindcancel="cancelTask"
  ></task-progress>

  <review-result
    wx:if="{{viewState === 'result'}}"
    task="{{task}}"
    bindcopy="copyFullText"
    binddownload="downloadDocx"
    bindregenerate="resetForm"
  ></review-result>
</view>

