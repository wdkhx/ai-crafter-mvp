<view class="page">
  <view class="hero">
    <view class="hero-title">AI CRAFTER</view>
    <view class="hero-subtitle">科研论文写作工具</view>
    <view class="hero-note">仅用于辅助写作与结构化初稿生成，禁止学术不端。</view>
  </view>

  <view wx:if="{{viewState === 'form'}}" class="panel">
    <view class="field">
      <text class="label">论文主题</text>
      <textarea class="textarea" placeholder="例如：基于深度学习的图像分类方法研究" value="{{form.topic}}" data-key="topic" bindinput="onInput" />
    </view>

    <view class="grid">
      <view class="field">
        <text class="label">论文字数</text>
        <input class="input" type="number" value="{{form.word_count}}" data-key="word_count" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">参考文献</text>
        <input class="input" type="number" value="{{form.reference_count}}" data-key="reference_count" bindinput="onInput" />
      </view>
    </view>

    <view class="field">
      <text class="label">学科领域</text>
      <picker mode="selector" range="{{fieldOptions}}" value="{{fieldIndex}}" bindchange="onFieldChange">
        <view class="picker">{{form.field}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">引用格式</text>
      <picker mode="selector" range="{{citationOptions}}" value="{{citationIndex}}" bindchange="onCitationChange">
        <view class="picker">{{form.citation_style}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">特殊要求</text>
      <textarea class="textarea short" placeholder="例如：需要包含实验部分，重点介绍 Transformer 模型" value="{{form.special_requirements}}" data-key="special_requirements" bindinput="onInput" />
    </view>

    <button class="primary-btn" loading="{{submitting}}" bindtap="submitPaper">提交生成</button>
  </view>

  <view wx:if="{{viewState === 'running'}}" class="panel">
    <view class="status-title">{{task.current_step}}</view>
    <progress percent="{{task.progress}}" stroke-width="8" activeColor="#2563eb" backgroundColor="#e4e7ec" />
    <view class="progress-row">
      <text>{{task.progress}}%</text>
      <text>预计剩余 {{task.estimated_remaining_seconds}} 秒</text>
    </view>
    <view class="steps">
      <view wx:for="{{task.workflow_trace}}" wx:key="key" class="step">
        <view class="dot {{item.status}}"></view>
        <view>
          <view class="step-name">{{item.name}}</view>
          <view class="step-summary">{{item.summary || '执行中'}}</view>
        </view>
      </view>
    </view>
    <button class="danger-btn" bindtap="cancelTask">取消生成</button>
  </view>

  <view wx:if="{{viewState === 'result'}}">
    <view class="panel result-head">
      <view class="result-title">{{task.result.title}}</view>
      <view class="metrics">
        <text>{{task.result.metrics.wordCount}} 字</text>
        <text>{{task.result.metrics.referenceCount}} 篇参考文献</text>
        <text>重复率约 {{task.result.metrics.estimatedDuplicationRate}}%</text>
      </view>
      <button class="primary-btn" bindtap="copyFullText">一键复制全文</button>
      <button class="ghost-btn" bindtap="downloadDocx">导出 .docx</button>
      <button class="ghost-btn" bindtap="resetForm">不满意，重新生成</button>
    </view>
    <view class="panel">
      <view class="section-title">摘要</view>
      <view class="paper-text">{{task.result.abstract}}</view>
      <block wx:for="{{task.result.sections}}" wx:key="heading">
        <view class="section-title">{{item.heading}}</view>
        <view class="paper-text">{{item.content}}</view>
      </block>
      <view class="section-title">参考文献</view>
      <view wx:for="{{task.result.references}}" wx:key="*this" class="reference">{{item}}</view>
    </view>
  </view>
</view>
