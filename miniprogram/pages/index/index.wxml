<view class="page page--safe">
  <toolbox-home
    wx:if="{{viewState === 'toolbox'}}"
    available-tools="{{availableTools}}"
    upcoming-tools="{{upcomingTools}}"
    bind:selecttool="handleSelectTool"
  />

  <paper-form
    wx:if="{{viewState === 'form'}}"
    form="{{form}}"
    field-options="{{fieldOptions}}"
    citation-options="{{citationOptions}}"
    field-index="{{fieldIndex}}"
    citation-index="{{citationIndex}}"
    show-advanced="{{showAdvanced}}"
    submitting="{{submitting}}"
    bind:formchange="handleFormChange"
    bind:fieldchange="handleFieldChange"
    bind:citationchange="handleCitationChange"
    bind:toggleadvanced="handleToggleAdvanced"
    bind:submit="submitPaper"
    bind:back="backToToolbox"
  />

  <task-progress
    wx:if="{{viewState === 'running'}}"
    task="{{task}}"
    bind:cancel="cancelTask"
  />

  <paper-result
    wx:if="{{viewState === 'result'}}"
    task="{{task}}"
    bind:copy="copyFullText"
    bind:download="downloadDocx"
    bind:regenerate="resetForm"
  />
</view>
