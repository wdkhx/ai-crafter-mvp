.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.clear-btn {
  width: 150rpx;
  margin: 0;
  font-size: 24rpx;
}

.history-card {
  margin-bottom: 20rpx;
}

.topic {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.meta {
  display: flex;
  gap: 20rpx;
  color: #475467;
  margin: 14rpx 0;
  font-size: 24rpx;
}

.empty {
  color: #667085;
  text-align: center;
}
