.task-progress {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 30rpx 28rpx;
}

.task-progress__title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.task-progress__meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
  margin: 18rpx 0 20rpx;
}

.task-progress__hint {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.55;
}

.task-progress__steps {
  margin: 32rpx 0;
}

.task-progress__step {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.task-progress__dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: #d1d5db;
  flex: 0 0 16rpx;
}

.task-progress__dot--running {
  background: #111827;
}

.task-progress__dot--succeeded {
  background: #047857;
}

.task-progress__step-name {
  color: #111827;
  font-size: 27rpx;
  font-weight: 650;
}

.task-progress__step-desc {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}
