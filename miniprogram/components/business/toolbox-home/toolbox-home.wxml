<view class="toolbox">
  <view class="toolbox__header">
    <view class="toolbox__brand">AI CRAFTER</view>
    <view class="toolbox__title">把前沿技术整理成可读文档</view>
    <view class="toolbox__subtitle">输入一个技术点，系统会抓取公开信号并生成结构化综述。</view>
  </view>

  <view class="toolbox__section">
    <view class="section-heading">可用工具</view>
    <tool-card wx:for="{{availableTools}}" wx:key="id" tool="{{item}}" bindselect="handleSelectTool"></tool-card>
  </view>

  <view class="toolbox__section toolbox__section--muted">
    <view class="section-heading">正在准备</view>
    <tool-card wx:for="{{upcomingTools}}" wx:key="id" tool="{{item}}" disabled="{{true}}"></tool-card>
  </view>
</view>
