page {
  background: #f7f7f5;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.primary-btn {
  background: #111827;
  color: #ffffff;
  border-radius: 12rpx;
  font-weight: 600;
}

.ghost-btn {
  background: #f3f4f6;
  color: #111827;
  border-radius: 10rpx;
  font-weight: 600;
}

.danger-btn {
  background: #fff1f3;
  color: #d92d20;
  border-radius: 12rpx;
}

.muted {
  color: #667085;
}
