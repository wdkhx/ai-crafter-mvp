page {
  background: #f6f7f9;
  color: #172026;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
  margin-bottom: 24rpx;
}

.primary-btn {
  background: #0f766e;
  color: #ffffff;
  border-radius: 12rpx;
  font-weight: 600;
}

.ghost-btn {
  background: #ecfdf5;
  color: #0f766e;
  border-radius: 12rpx;
  font-weight: 600;
}

.danger-btn {
  background: #fff1f3;
  color: #d92d20;
  border-radius: 12rpx;
}

.muted {
  color: #667085;
}
