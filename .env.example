# Server
PORT=4000
NODE_ENV=development
CLIENT_BASE_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_crafter

# API auth used by the mini program demo and developer platform demo.
# Replace this before production.
API_DEMO_TOKEN=dev-token

# LangChain / LLM
# Keep USE_REAL_LLM=false to run the MVP without external keys.
USE_REAL_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Use this for OpenAI-compatible third-party providers.
OPENAI_BASE_URL=

# Intelligence crawler
INTELLIGENCE_KEYWORDS=ai agent,langgraph,rag agent,multi agent,llm workflow
